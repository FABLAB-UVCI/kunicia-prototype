# Registre Yarn (registry.yarnpkg.com) : le seul registre rapide et fiable sur
# le réseau de build Voisilab (npmjs.org y est bloqué, npmmirror trop lent).
# npm remplace automatiquement les URL npmjs.org du package-lock.json par ce
# registre au moment de l'install (replace-registry-host par défaut).
registry=https://registry.yarnpkg.com
fetch-retries=5
fetch-retry-factor=2
fetch-timeout=600000
