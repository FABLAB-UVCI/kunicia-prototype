# URL de base des appels API : les route handlers Next.js (app/api) sont
# servis par le frontend lui-même — "/api" en relatif (même origine).
NEXT_PUBLIC_API_URL=/api
# origine encodée dans les QR codes des cages (voir lib/qr-cage.ts) : doit
# être joignable depuis un téléphone, donc pas localhost. À remplacer par le
# vrai nom de domaine en production, ou à mettre à jour si l'URL ngrok change.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Variables serveur (jamais exposées au navigateur) ---
# même base PostgreSQL que backend/.env (les deux apps partagent la même DB)
DATABASE_URL=postgresql://<utilisateur>:<mot_de_passe>@localhost:5432/cunicole_db?schema=public
# secret JWT — réutilise celui de backend/.env pour que les sessions existantes
# restent valides pendant la transition (openssl rand -hex 32 sinon)
JWT_SECRET=<secret-64-caracteres>
JWT_EXPIRES_IN=3650d
# URL du service de prédiction IA (ml-service)
PYTHON_API_URL=http://localhost:8000
