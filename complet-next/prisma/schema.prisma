// ==========================================
// SCHÉMA FINAL - Plateforme Élevage Cunicole
// ==========================================

generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------
// UTILISATEUR (1 compte = 1 ferme)
// ------------------------------------------
model Utilisateur {
  id            String   @id @default(uuid())
  nom           String
  nomFerme      String
  email         String   @unique
  motDePasse    String
  // ADMIN = accès à la partie administration de la plateforme ; actif=false
  // bloque la connexion (gestion des comptes par l'admin)
  role          Role     @default(ELEVEUR)
  actif         Boolean  @default(true)
  createdAt     DateTime @default(now())

  lapins        Lapin[]
  cages         Cage[]
  stocks        StockAlimentation[]
  races         Race[]
  clients       Client[]
  ventes        Vente[]
  depenses      Depense[]
}

// ------------------------------------------
// RACE (liste de races gérée par l'éleveur,
// modifiable — remplace l'ancien champ texte
// libre sur Lapin)
// ------------------------------------------
model Race {
  id                String   @id @default(uuid())
  nom               String
  poidsAdulteMoyen  Float?   // kg, indicatif — sert de repère, pas utilisé dans le calcul du modèle IA
  paysOrigine       String?
  aptitude          String?  // ex. "Chair", "Laine", "Ornementale"
  caracteristiques  String[] @default([]) // traits libres : "Robe fauve", "Croissance lente", "Grande taille"...
  createdAt         DateTime @default(now())

  eleveurId String
  eleveur   Utilisateur @relation(fields: [eleveurId], references: [id])

  lapins    Lapin[]

  @@unique([eleveurId, nom])
}

// ------------------------------------------
// LAPIN (cœur du système)
// ------------------------------------------
model Lapin {
  id                  String      @id @default(uuid())
  codeIdentification  String      @unique   // ex: "F012-25-03"
  nom                 String?     // optionnel, pour identifier plus facilement qu'avec le seul matricule
  photoUrl            String?     // null = pas de photo prise, on affiche un placeholder générique
  raceId              String?
  race                Race?       @relation(fields: [raceId], references: [id])
  sexe                Sexe?
  dateNaissance       DateTime?
  statut              StatutLapin @default(EN_CROISSANCE)
  // false pour un lot de lapins créés en attente d'identification physique
  // (oreilles marquées) — race/sexe/dateNaissance restent alors nuls tant
  // que l'éleveur n'a pas complété la fiche (cf. PATCH /lapins/:id/identifier)
  identifie           Boolean     @default(true)

  // Généalogie (null = origine inconnue / lapin acheté à l'extérieur)
  pereId              String?
  mereId              String?
  pere                Lapin?      @relation("Paternite", fields: [pereId], references: [id])
  mere                Lapin?      @relation("Maternite", fields: [mereId], references: [id])
  enfantsPaternite    Lapin[]     @relation("Paternite")
  enfantsMaternite    Lapin[]     @relation("Maternite")

  origineExterieure   Boolean     @default(false) // true si acheté, pas né dans la ferme

  eleveurId           String
  eleveur             Utilisateur @relation(fields: [eleveurId], references: [id])

  porteeId            String?
  portee              Portee?     @relation(fields: [porteeId], references: [id])

  cageActuelleId      String?     // dénormalisé : mis à jour à chaque mouvement (ENTREE_CAGE = cage, DECES/VENTE = null)
  cageActuelle        Cage?       @relation(fields: [cageActuelleId], references: [id])

  pesees              Pesee[]
  santes              Sante[]
  ventes              Vente[]
  predictions         Prediction[]
  mouvements          MouvementLapin[]

  accouplementsMale    Accouplement[] @relation("AccouplementMale")
  accouplementsFemelle Accouplement[] @relation("AccouplementFemelle")

  createdAt           DateTime    @default(now())
}

enum Sexe {
  MALE
  FEMELLE
}

enum Role {
  ELEVEUR
  ADMIN
}

enum StatutLapin {
  EN_CROISSANCE
  REPRODUCTEUR    // affiché "Reproducteur"/"Reproductrice" selon le sexe (cf. frontend)
  EN_GESTATION    // femelle uniquement : de la validation de l'accouplement à la mise bas
  ALLAITEMENT     // femelle uniquement : de la mise bas au sevrage confirmé
  VENDU
  DECEDE
}

// ------------------------------------------
// PORTEE (créée à la naissance ; les fiches
// Lapin individuelles arrivent au SEVRAGE)
// ------------------------------------------
model Portee {
  id                  String   @id @default(uuid())
  dateNaissance       DateTime
  nombreNes           Int
  dateSevrage         DateTime? // rempli quand l'éleveur confirme le sevrage (nombreSevres = lapins.length)
  poidsMoyenNaissance Float?   // optionnel (pesée naissance pas systématique)

  accouplementId      String   @unique
  accouplement        Accouplement @relation(fields: [accouplementId], references: [id])

  lapins              Lapin[]  // créés individuellement au sevrage
}

// ------------------------------------------
// ACCOUPLEMENT (avec vérif. consanguinité)
// ------------------------------------------
model Accouplement {
  id                    String   @id @default(uuid())
  maleId                String
  femelleId             String
  male                  Lapin    @relation("AccouplementMale", fields: [maleId], references: [id])
  femelle               Lapin    @relation("AccouplementFemelle", fields: [femelleId], references: [id])

  dateAccouplement      DateTime
  coefficientParente    Float
  // libellé du lien de parenté détecté (frère/sœur, cousins, etc.), dérivé
  // de l'arbre généalogique au moment de la proposition — cf.
  // accouplement.service.ts, libelleTypeParente(). Null si aucun lien
  // proche détecté (accouplement d'avant cette fonctionnalité, ou lapins
  // non apparentés)
  typeParente           String?
  statut                StatutAccouplement @default(EN_ATTENTE)
  motifValidationForcee String?  // rempli seulement si validation malgré alerte

  portee                Portee?

  createdAt             DateTime @default(now())
}

enum StatutAccouplement {
  EN_ATTENTE
  VALIDE
  VALIDE_MALGRE_ALERTE
  ANNULE
}

// ------------------------------------------
// CAGE (infrastructure fixe, QR permanent)
// ------------------------------------------
model Cage {
  id           String    @id @default(uuid())
  numero       String    @unique       // ex: "C-12"
  type         TypeCage
  qrCode       String    @unique       // valeur encodée = cage id
  capacite     Int?                    // seuil d'alerte, pas de blocage
  emplacement  String?

  eleveurId    String
  eleveur      Utilisateur @relation(fields: [eleveurId], references: [id])

  mouvements   MouvementLapin[]
  lapinsActuels Lapin[]  // dénormalisé via Lapin.cageActuelleId

  createdAt    DateTime  @default(now())
}

enum TypeCage {
  INDIVIDUELLE
  COLLECTIVE
  NID
}

// ------------------------------------------
// MOUVEMENT LAPIN (journal d'événements ;
// la position actuelle = dernier mouvement
// de type ENTREE_CAGE pour ce lapin)
// ------------------------------------------
model MouvementLapin {
  id            String        @id @default(uuid())
  lapinId       String
  lapin         Lapin         @relation(fields: [lapinId], references: [id])

  cageId        String?       // rempli seulement pour ENTREE_CAGE
  cage          Cage?         @relation(fields: [cageId], references: [id])

  typeMouvement TypeMouvement
  dateMouvement DateTime      @default(now())
  commentaire   String?
}

enum TypeMouvement {
  ENTREE_CAGE   // affectation à une cage (première fois ou changement)
  DECES
  VENTE
  CONTROLE      // scan de vérification, rien ne change
}

// ------------------------------------------
// PESEE (alimente le modèle IA)
// ------------------------------------------
model Pesee {
  id        String   @id @default(uuid())
  lapinId   String
  lapin     Lapin    @relation(fields: [lapinId], references: [id])
  date      DateTime @default(now())
  poids     Float    // en kg
}

// ------------------------------------------
// SANTE (suivi vaccination/soins par lapin —
// même logique que Pesee : historique daté,
// rattaché au lapin, propriété via lapin.eleveurId)
// ------------------------------------------
model Sante {
  id             String    @id @default(uuid())
  lapinId        String
  lapin          Lapin     @relation(fields: [lapinId], references: [id])
  type           String    // ex. "Vaccination VHD", "Vermifuge"
  date           DateTime  @default(now())
  dateRappel     DateTime? // prochaine échéance prévue (rappel), optionnelle
  notes          String?
}

// ------------------------------------------
// PREDICTION (résultat du modèle IA, stocké
// pour comparaison ultérieure réel vs prédit)
// ------------------------------------------
model Prediction {
  id            String   @id @default(uuid())
  lapinId       String
  lapin         Lapin    @relation(fields: [lapinId], references: [id])
  dateCalcul    DateTime @default(now())
  poidsPredit   Float
  dateEcheance  DateTime
  poidsReel     Float?   // rempli plus tard pour évaluer la fiabilité
}

// ------------------------------------------
// STOCK ALIMENTATION
// ------------------------------------------
model StockAlimentation {
  id                String   @id @default(uuid())
  typeAliment       String
  quantiteInitiale  Float    // kg
  quantiteRestante  Float    // recalculée à chaque distribution
  dateAchat         DateTime @default(now())

  eleveurId         String
  eleveur           Utilisateur @relation(fields: [eleveurId], references: [id])

  distributions     DistributionAlimentation[]
}

model DistributionAlimentation {
  id                      String   @id @default(uuid())
  stockId                 String
  stock                   StockAlimentation @relation(fields: [stockId], references: [id])

  cageId                  String?  // distribution par cage/lot

  quantiteParJour         Float    // kg/jour/lapin
  nombreLapins            Int
  dateDebut               DateTime @default(now())

  consommationJournaliere Float    // = quantiteParJour * nombreLapins
  dateEpuisementEstimee   DateTime
}

// ------------------------------------------
// FINANCE (clients, ventes, dépenses — pour
// la page Finance : chiffre d'affaires, dépenses, solde)
// ------------------------------------------
model Client {
  id        String   @id @default(uuid())
  nom       String
  telephone String?
  adresse   String?
  createdAt DateTime @default(now())

  eleveurId String
  eleveur   Utilisateur @relation(fields: [eleveurId], references: [id])

  ventes    Vente[]
}

model Vente {
  id        String   @id @default(uuid())
  lapinId   String
  lapin     Lapin    @relation(fields: [lapinId], references: [id])

  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])

  prix      Float    // devise implicite = celle de l'éleveur, non convertie
  dateVente DateTime @default(now())
  createdAt DateTime @default(now())

  eleveurId String
  eleveur   Utilisateur @relation(fields: [eleveurId], references: [id])
}

model Depense {
  id        String   @id @default(uuid())
  categorie String   // ex. "Alimentation", "Vétérinaire", "Équipement", "Autre"
  libelle   String
  montant   Float
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  eleveurId String
  eleveur   Utilisateur @relation(fields: [eleveurId], references: [id])
}
