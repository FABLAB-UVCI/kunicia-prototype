# PostgreSQL managé (plateforme / serveur) — l'URL est injectée par la plateforme.
# En local : doit être joignable DEPUIS les conteneurs (IP LAN de l'hôte, ou
# host.docker.internal si tu ajoutes extra_hosts: host-gateway au service app).
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/cunicole_db?schema=public

# Secret JWT — identique partout (openssl rand -hex 32)
JWT_SECRET=changez-moi-64-caracteres
JWT_EXPIRES_IN=3650d

# ==== LA COM DES DEUX PROJETS ====
# Prod : URL publique du service ml sur la plateforme (https://<app-ml>.voisilab.app)
# Local (compose) : nom de service du réseau docker
PYTHON_API_URL=http://ml-service:8000

# Inlinées au build (build args) — origine publique du site (QR cages)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api
